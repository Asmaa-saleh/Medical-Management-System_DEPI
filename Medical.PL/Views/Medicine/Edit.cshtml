@using Medical.PL.Data.Enum
@model Medical.PL.Data.Models.Medicine

@{
    ViewData["Title"] = "تعديل دواء";
    ViewData["ActivePage"] = "Medicines";
}

@section Styles {
    <link rel="stylesheet" href="~/css/doctor-schedule-index.css" asp-append-version="true" />

    <style>
        .form-card {
            padding: 20px;
        }

        .form-control:focus,
        .form-select:focus {
            box-shadow: none;
            border-color: #ffc107;
        }
    </style>
}

<!-- Header (زي DoctorSchedule) -->
<div class="pg-header">
    <h1><i class="bi bi-capsule"></i> تعديل دواء</h1>

    <a asp-action="Index" class="btn-add" style="background:#6c757d;">
        <i class="fas fa-arrow-left"></i> رجوع
    </a>
</div>

<!-- Card -->
<div class="tbl-card">
    <div class="form-card">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="row">

                <!-- Name -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">اسم الدواء</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Generic -->
                <div class="col-md-6 mb-3">
                    <label asp-for="GenericName" class="form-label fw-semibold">الاسم العلمي</label>
                    <input asp-for="GenericName" class="form-control" />
                    <span asp-validation-for="GenericName" class="text-danger"></span>
                </div>

                <!-- Category -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Category" class="form-label fw-semibold">التصنيف</label>
                    <select asp-for="Category"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<MedicineCategory>()">
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <!-- Form -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Form" class="form-label fw-semibold">الشكل الدوائي</label>
                    <select asp-for="Form"
                            class="form-select"
                            asp-items="Html.GetEnumSelectList<MedicineForm>()">
                    </select>
                    <span asp-validation-for="Form" class="text-danger"></span>
                </div>

                <!-- Strength -->
                <div class="col-md-12 mb-3">
                    <label asp-for="Strength" class="form-label fw-semibold">القوة</label>
                    <input asp-for="Strength" class="form-control" />
                    <span asp-validation-for="Strength" class="text-danger"></span>
                </div>

            </div>

            <!-- Buttons (زي DoctorSchedule actions style) -->
            <div class="d-flex justify-content-end gap-2 mt-3">

                <a asp-action="Index" class="btn-add" style="background:#6c757d;">
                    إلغاء
                </a>

                <button type="submit" class="btn-add" style="background:#ffc107; color:#000;">
                    <i class="fas fa-save"></i> حفظ التعديلات
                </button>

            </div>

        </form>

    </div>
</div>