@model IEnumerable<Medical.PL.Data.Models.Medicine>

@{
    ViewData["Title"] = "الأدوية";
    ViewData["ActivePage"] = "Medicines";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/doctor-schedule-index.css" asp-append-version="true" />

    <style>
        .pg-header {
            padding: 15px 0;
            border-bottom: 1px solid #eee;
        }

        .tbl-card {
            background: #fff;
            border-radius: 12px;
            padding: 15px;
        }

        .doc-avatar {
            /* width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eef2ff;
            color: #0d6efd; */
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: #ECFEFF;
            color: #0891B2;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        

        .tbl tr:hover {
            background: #f9fafb;
            transition: 0.2s;
        }

        .badge {
            padding: 6px 10px;
            border-radius: 20px;
            font-weight: 500;
        }
    </style>
}

<!-- HEADER -->

<div class="pg-header d-flex justify-content-between align-items-center flex-wrap gap-3">

    <div>
        <h1 class="mb-0">
            <i class="bi bi-capsule"></i> الأدوية
        </h1>
         @* <small class="text-muted">إدارة الأدوية داخل النظام</small>  *@
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">

        <!-- SEARCH -->
         <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">

            <div class="input-group" style="max-width: 260px;">

                <span class="input-group-text bg-white rounded-start-pill">
                    <i class="bi bi-search text-muted"></i>
                </span>

                <input type="text"
                       name="searchTerm"
                       class="form-control rounded-end-pill"
                       placeholder="ابحث عن دواء..."
                       value="@Context.Request.Query["searchTerm"]" />

            </div>

            <button type="submit" class="btn btn-primary rounded-pill btn-sm px-3">
                بحث
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
                إعادة
            </a>

           </form> 

        

        <!-- ADD -->
        <a asp-action="Create" class="btn-add">
            <i class="fas fa-plus"></i> إضافة دواء
        </a>

    </div>
</div> 

<!-- TABLE -->
<div class="tbl-card shadow-sm mt-3">

    @if (Model.Any())
    {
        <div class="table-responsive">

            <table class="tbl table align-middle">

                <thead class="table-light">
                    <tr>
                        <th>الاسم</th>
                        <th>النوع</th>
                        <th>الشكل</th>
                        <th>القوة</th>
                        <th>الاسم العلمي</th>
                        <th class="text-center">إجراءات</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- NAME -->
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    
                                    <div class="doc-avatar">
                                        <i class="bi bi-capsule"></i>
                                    </div>
                                    <strong>@item.Name</strong>
                                </div>
                            </td>

                            <td><span class="badge bg-info text-dark">@item.Category</span></td>

                            <td><span class="badge bg-secondary">@item.Form</span></td>

                            <td><span class="badge bg-success">@item.Strength</span></td>

                            <td class="text-muted">@item.GenericName</td>

                            <!-- ACTIONS -->
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">

                                    <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info rounded-pill">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning rounded-pill">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger rounded-pill">
                                        <i class="fas fa-trash"></i>
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <!-- EMPTY STATE -->
        <div class="text-center py-5"> 

            <i class="bi bi-capsule text-muted" style="font-size:50px;"></i>

            <h4 class="mt-3">لا يوجد أدوية حالياً</h4>
            <p class="text-muted">ابدأ بإضافة دواء جديد للنظام</p>

            <a asp-action="Create" class="btn-add mt-2 d-inline-block">
                <i class="fas fa-plus"></i> إضافة دواء
            </a>

        </div>
    }

</div>



