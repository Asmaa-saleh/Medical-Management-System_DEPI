@model Medical.PL.Data.Models.Medicine

@{
    ViewData["Title"] = "تفاصيل الدواء";
    ViewData["ActivePage"] = "Medicines";
}

@section Styles {
    <link rel="stylesheet" href="~/css/doctor-schedule-index.css" asp-append-version="true" />

    <style>
        .info-box {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            min-height: 110px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .medicine-title {
            font-weight: 700;
        }

        .medicine-sub {
            color: #777;
            font-size: 0.9rem;
        }
    </style>
}

<!-- Header -->
<div class="pg-header">
    <h1><i class="bi bi-capsule"></i> تفاصيل الدواء</h1>

    <a asp-action="Index" class="btn-add" style="background:#6c757d;">
        <i class="fas fa-arrow-left"></i> رجوع
    </a>
</div>

<!-- Card -->
<div class="tbl-card">

    <div class="p-4">

        <!-- Title -->
        <div class="text-center mb-4">
            <h3 class="medicine-title">@Model.Name</h3>
            <p class="medicine-sub">@Model.GenericName</p>
        </div>

        <hr />

        <!-- Info -->
        <div class="row">

            <!-- Category -->
            <div class="col-md-6 mb-3">
                <div class="info-box">
                    <small class="text-muted">التصنيف</small>
                    <span class="badge bg-info text-dark mt-2 fs-6">
                        @Model.Category
                    </span>
                </div>
            </div>

            <!-- Form -->
            <div class="col-md-6 mb-3">
                <div class="info-box">
                    <small class="text-muted">الشكل الدوائي</small>
                    <span class="badge bg-secondary mt-2  fs-6 ">
                        @Model.Form
                    </span>
                </div>
            </div>

            <!-- Strength -->
            <div class="col-md-12 mb-3">
                <div class="info-box" style="min-height:120px;">
                    <small class="text-muted">القوة</small>
                    <h5 class="mt-2">@Model.Strength</h5>
                </div>
            </div>

        </div>

        <!-- Actions -->
        <div class="d-flex justify-content-center gap-2 mt-4">

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-add" style="background:#ffc107; color:#000;">
                <i class="fas fa-edit"></i> تعديل
            </a>

            <a asp-action="Index" class="btn-add" style="background:#6c757d;">
                رجوع للقائمة
            </a>

        </div>

    </div>

</div>