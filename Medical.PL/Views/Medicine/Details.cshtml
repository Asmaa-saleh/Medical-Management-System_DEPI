@model Medical.PL.Data.Models.Medicine

@{
    ViewData["Title"] = "Medicine Details";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">Medicine Details</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Back
        </a>
    </div>

    <!-- Card -->
    <div class="card shadow-lg border-0">

        <div class="card-body p-4">

            <!-- Title -->
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark">@Model.Name</h3>
                <p class="text-muted mb-0">@Model.GenericName</p>
            </div>

            <hr />

            <!-- Info Grid -->
            <div class="row">

                <div class="col-md-6 mb-3">
                    <div class="p-3 bg-light rounded d-flex flex-column justify-content-center align-items-center text-center" style="min-height: 100px;">
        
                        <small class="text-muted">Category</small>

                        <span class="badge bg-info text-dark fs-6 mt-2">
                            @Model.Category
                        </span>

                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <div class="p-3 bg-light rounded d-flex flex-column justify-content-center align-items-center text-center" style="min-height: 100px;">
        
                        <small class="text-muted">Form</small>

                        <span class="badge bg-secondary fs-6 mt-2">
                            @Model.Form
                        </span>

                    </div>
                </div>

                <div class="col-md-12 mb-3">
                    <div class="p-3 bg-light rounded d-flex flex-column justify-content-center align-items-center text-center" style="min-height: 120px;">
        
                        <small class="text-muted">Strength</small>

                        <strong class="fs-5 mt-2">
                            @Model.Strength
                        </strong>

                    </div>
                </div>

            </div>

            <!-- Actions -->
            <div class="d-flex justify-content-center gap-2 mt-4">

                <a asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn btn-warning px-4">
                     Edit
                </a>

                <a asp-action="Index"
                       class="btn btn-outline-primary px-4">
                     Back to List
                </a>

            </div>

        </div>
    </div>

</div>