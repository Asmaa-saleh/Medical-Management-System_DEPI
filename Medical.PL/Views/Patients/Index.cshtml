@model IEnumerable<Medical.PL.ViewModels.PatientVM>

@{
    ViewData["Title"] = "المرضى";
    ViewData["ActivePage"] = "Patients";
}

@section Styles {
    <link rel="stylesheet" href="~/css/patient-index.css" asp-append-version="true" />
}

<div class="pg-header">
    <h1><i class="fas fa-users"></i> المرضى</h1>
    <a asp-action="Create" class="btn-add">
        <i class="fas fa-plus"></i> إضافة مريض جديد
    </a>
</div>

<div class="tbl-card">
    @if (Model.Any())
    {
        <table class="tbl">
            <thead>
                <tr>
                    <th>المريض</th>
                    <th>الجنس</th>
                    <th>تاريخ الميلاد</th>
                    <th>الهاتف</th>
                    <th>البريد الإلكتروني</th>
                    <th>الحجوزات</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in Model)
                {
                    <tr>
                        <td>
                            <div class="patient-cell">
                                <div class="patient-avatar"><i class="fas fa-user"></i></div>
                                <div>
                                    <div class="patient-name">@patient.Name</div>
                                    <div class="patient-id">#@patient.Id</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge-gender @(patient.Gender == "ذكر" ? "bg-male" : "bg-female")">
                                <i class="fas @(patient.Gender == "ذكر" ? "fa-mars" : "fa-venus")"></i>
                                @patient.Gender
                            </span>
                        </td>
                        <td>@patient.DateOfBirth.ToString("dd/MM/yyyy")</td>
                        <td>@patient.Phone</td>
                        <td class="email-cell">@patient.Email</td>
                        <td>
                            <a asp-action="Appointments" asp-route-id="@patient.Id" class="badge-count">
                                @patient.AppointmentsCount
                            </a>
                        </td>
                        <td>
                            <div class="act-btns">
                                <a asp-action="Details" asp-route-id="@patient.Id" class="act-btn ab-view" title="عرض"><i class="fas fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@patient.Id" class="act-btn ab-edit" title="تعديل"><i class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@patient.Id" class="act-btn ab-delete" title="حذف"><i class="fas fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty">
            <i class="fas fa-users"></i>
            <h3>لا يوجد مرضى حالياً</h3>
            <p>ابدأ بإضافة مريض جديد للنظام</p>
            <a asp-action="Create" class="btn-add">
                <i class="fas fa-plus"></i> إضافة مريض
            </a>
        </div>
    }
</div>
