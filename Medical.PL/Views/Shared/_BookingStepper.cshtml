

@model int

<style>
    .stepper-vertical {
        display: flex;
        flex-direction: column;
        gap: 18px;
        margin: 25px 0;
        direction: rtl;
    }

    .step {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        position: relative;
    }

        /* الخط بين الخطوات */
        .step:not(:last-child)::after {
            content: "";
            position: absolute;
            top: 38px;
            right: 15px;
            width: 2px;
            height: 35px;
            background: #e2e8f0;
        }

    /* الدائرة */
    .step-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #e2e8f0;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: bold;
        flex-shrink: 0;
        z-index: 2;
    }

    /* النص */
    .step-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .step-title {
        font-size: 15px;
        font-weight: 700;
        color: #94a3b8;
    }

    .step-subtitle {
        font-size: 12px;
        color: #cbd5e1;
    }

    /* Active */
    .step.active .step-circle {
        background: linear-gradient(135deg, #0E7490, #0891B2);
        color: white;
        box-shadow: 0 6px 15px rgba(14,116,144,0.25);
    }

    .step.active .step-title {
        color: #0f172a;
    }

    .step.active .step-subtitle {
        color: #64748b;
    }

    /* Completed */
    .step.completed .step-circle {
        background: #10b981;
        color: white;
    }

    /* Card */
    .stepper-wrapper {
        background: #fff;
        border-radius: 22px;
        padding: 22px;
        border: 1px solid #edf2f7;
        box-shadow: 0 8px 25px rgba(15,23,42,0.05);
        margin-top:40px;
        padding-bottom: 130px;
    }
</style>

<div class="stepper-wrapper">

    <div class="stepper-vertical">

        <!-- الخدمة -->
        <div class="step @(Model >= 1 ? "active" : "")">
            <div class="step-circle">1</div>

            <div class="step-content">
                <div class="step-title">اختيار الخدمة</div>
                <div class="step-subtitle">
                    اختر الخدمة الطبية المناسبة
                </div>
            </div>
        </div>

        <!-- الطبيب -->
        <div class="step @(Model >= 2 ? "active" : "")">
            <div class="step-circle">2</div>

            <div class="step-content">
                <div class="step-title">اختيار الطبيب</div>
                <div class="step-subtitle">
                    اختر الطبيب المناسب للحجز
                </div>
            </div>
        </div>

        <!-- الموعد -->
        <div class="step @(Model >= 3 ? "active" : "")">
            <div class="step-circle">3</div>

            <div class="step-content">
                <div class="step-title">اختيار الموعد</div>
                <div class="step-subtitle">
                    حدد اليوم والوقت المناسب
                </div>
            </div>
        </div>

        @* <!-- بيانات المريض -->
        <div class="step @(Model >= 4 ? "active" : "")">
            <div class="step-circle">4</div>

            <div class="step-content">
                <div class="step-title">بيانات المريض</div>
                <div class="step-subtitle">
                    أدخل بيانات الحجز المطلوبة
                </div>
            </div>
        </div> *@

        <!-- التأكيد -->
        <div class="step @(Model >= 4 ? "active" : "")">
            <div class="step-circle">4</div>

            <div class="step-content">
                <div class="step-title">تأكيد الحجز</div>
                <div class="step-subtitle">
                    مراجعة وتأكيد تفاصيل الحجز
                </div>
            </div>
        </div>

    </div>

</div>