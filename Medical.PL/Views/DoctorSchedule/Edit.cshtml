@model DoctorSchedule

@{
    ViewData["Title"] = "تعديل جدول العمل";
    ViewData["ActivePage"] = "Schedules";
}

@section Styles {
    <link rel="stylesheet" href="~/css/doctor-schedule-edit.css" asp-append-version="true" />
}

<div class="form-header">
    <h1><i class="fas fa-edit"></i> تعديل جدول العمل</h1>
    <p>تعديل مواعيد عمل الطبيب</p>
</div>

<div class="form-card">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-msg"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UpdatedAt" />

        <div class="fg">

            <div class="fg-item fg-full">
                <label><i class="fas fa-user-md"></i> الطبيب</label>
                <select asp-for="DoctorId" asp-items="@ViewBag.Doctors" class="fc">
                    <option value="">-- اختر الطبيب --</option>
                </select>
                <span asp-validation-for="DoctorId" class="validation-msg"></span>
            </div>

            <div class="fg-item">
                <label><i class="fas fa-calendar-day"></i> اليوم</label>
                <select asp-for="DayOfWeek" asp-items="@ViewBag.Days" class="fc">
                    <option value="">-- اختر اليوم --</option>
                </select>
                <span asp-validation-for="DayOfWeek" class="validation-msg"></span>
            </div>

            <div class="fg-item">
                <label><i class="fas fa-users"></i> أقصى عدد مرضى</label>
                <input asp-for="MaxPatients" type="number" class="fc" min="1" />
                <span asp-validation-for="MaxPatients" class="validation-msg"></span>
            </div>

            <div class="fg-item">
                <label><i class="fas fa-hourglass-start"></i> وقت البداية</label>
                <input asp-for="StartTime" type="time" class="fc" />
                <span asp-validation-for="StartTime" class="validation-msg"></span>
            </div>

            <div class="fg-item">
                <label><i class="fas fa-hourglass-end"></i> وقت النهاية</label>
                <input asp-for="EndTime" type="time" class="fc" />
                <span asp-validation-for="EndTime" class="validation-msg"></span>
            </div>

            <div class="fg-item">
                <label><i class="fas fa-globe"></i> أقصى حجز أونلاين</label>
                <input asp-for="MaxOnlineBooking" type="number" class="fc" min="0" />
                <span asp-validation-for="MaxOnlineBooking" class="validation-msg"></span>
            </div>

        </div>

        <div class="form-actions">
            <button type="submit" class="btn-save">
                <i class="fas fa-save"></i> حفظ التعديلات
            </button>
            <a asp-action="Index" class="btn-back">
                <i class="fas fa-arrow-right"></i> رجوع
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
