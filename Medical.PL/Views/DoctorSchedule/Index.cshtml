@model IEnumerable<DoctorSchedule>

@{
    ViewData["Title"] = "جداول عمل الأطباء";
    ViewData["ActivePage"] = "Schedules";
}

@section Styles {
    <link rel="stylesheet" href="~/css/doctor-schedule-index.css" asp-append-version="true" />
}

<div class="pg-header">
    <h1><i class="fas fa-clock"></i> جداول عمل الأطباء</h1>
    <a asp-action="Create" class="btn-add">
        <i class="fas fa-plus"></i> إضافة جدول جديد
    </a>
</div>

<div class="tbl-card">
    @if (Model.Any())
    {
        <table class="tbl">
            <thead>
                <tr>
                    <th>الطبيب</th>
                    <th>اليوم</th>
                    <th>من</th>
                    <th>إلى</th>
                    <th>أقصى عدد</th>
                    <th>أونلاين</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>
                            <div class="doc-cell">
                                <div class="doc-avatar"><i class="fas fa-user-md"></i></div>
                                <div>
                                    <div class="doc-name">د. @s.Doctor.User.Name</div>
                                    <div class="doc-spec">@s.Doctor.Specialization</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge-day">@s.DayOfWeek</span></td>
                        <td><span class="badge-time">@s.StartTime.ToString(@"hh\:mm")</span></td>
                        <td><span class="badge-time">@s.EndTime.ToString(@"hh\:mm")</span></td>
                        <td><span class="badge-count">@s.MaxPatients</span></td>
                        <td><span class="badge-online">@s.MaxOnlineBooking</span></td>
                        <td>
                            <div class="act-btns">
                                <a asp-action="Details" asp-route-id="@s.Id" class="act-btn ab-view" title="عرض"><i class="fas fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@s.Id" class="act-btn ab-edit" title="تعديل"><i class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@s.Id" class="act-btn ab-delete" title="حذف"><i class="fas fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty">
            <i class="fas fa-calendar-times" style="font-size:40px;"></i>
            <h3>لا يوجد جداول عمل حالياً</h3>
            <p>ابدأ بإضافة جدول عمل جديد لأحد الأطباء</p>
            <a asp-action="Create" class="btn-add mt-3 d-inline-block">
                <i class="fas fa-plus"></i> إضافة جدول عمل
            </a>
        </div>
    }
</div>
