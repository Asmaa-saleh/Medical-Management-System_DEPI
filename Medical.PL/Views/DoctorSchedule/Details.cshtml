@model DoctorSchedule

@{
    ViewData["Title"] = "تفاصيل جدول العمل";
    ViewData["ActivePage"] = "Schedules";
}

@section Styles {
    <link rel="stylesheet" href="~/css/doctor-schedule-details.css" asp-append-version="true" />
}

<div class="det-header">
    <h1><i class="fas fa-info-circle"></i> تفاصيل جدول العمل</h1>
</div>

<div class="det-card">
    <div class="det-top">
        <div class="det-avatar"><i class="fas fa-user-md"></i></div>
        <div>
            <div class="det-doc-name">د. @Model.Doctor.User.Name</div>
            <div class="det-doc-spec">@Model.Doctor.Specialization</div>
        </div>
    </div>

    <div class="det-body">
        <div class="det-row">
            <span class="det-label"><i class="fas fa-calendar-day"></i> اليوم</span>
            <span class="det-badge db-teal">@Model.DayOfWeek</span>
        </div>
        <div class="det-row">
            <span class="det-label"><i class="fas fa-hourglass-start"></i> وقت البداية</span>
            <span class="det-badge db-blue">@Model.StartTime.ToString(@"hh\:mm")</span>
        </div>
        <div class="det-row">
            <span class="det-label"><i class="fas fa-hourglass-end"></i> وقت النهاية</span>
            <span class="det-badge db-blue">@Model.EndTime.ToString(@"hh\:mm")</span>
        </div>
        <div class="det-row">
            <span class="det-label"><i class="fas fa-users"></i> أقصى عدد مرضى</span>
            <span class="det-badge db-amber">@Model.MaxPatients مريض</span>
        </div>
        <div class="det-row">
            <span class="det-label"><i class="fas fa-globe"></i> أقصى حجز أونلاين</span>
            <span class="det-badge db-purple">@Model.MaxOnlineBooking حجز</span>
        </div>
        <div class="det-row">
            <span class="det-label"><i class="fas fa-sync"></i> آخر تحديث</span>
            <span class="det-badge db-gray">@Model.UpdatedAt.ToString("yyyy/MM/dd hh:mm tt")</span>
        </div>
    </div>

    <div class="det-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-det-edit">
            <i class="fas fa-edit"></i> تعديل
        </a>
        <a asp-action="Index" class="btn-det-back">
            <i class="fas fa-arrow-right"></i> رجوع
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-det-del">
            <i class="fas fa-trash"></i> حذف
        </a>
    </div>
</div>
