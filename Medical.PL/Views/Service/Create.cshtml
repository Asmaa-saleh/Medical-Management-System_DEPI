@model ServiceFormViewModel

@{
    ViewData["Title"] = "إضافة خدمة";
    ViewData["ActivePage"] = "Services";
}

@section Styles {
    <link rel="stylesheet" href="~/css/service-form.css" asp-append-version="true" />
}

<div class="form-header">
    <h1><i class="fas fa-plus-circle"></i> إضافة خدمة جديدة</h1>
    <p>أدخل بيانات الخدمة وحدد القسم التابع لها</p>
</div>

<div class="form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-msg"></div>

        <partial name="_Form" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn-save">
                <i class="fas fa-check"></i> حفظ
            </button>
            <a asp-action="Index" class="btn-back">
                <i class="fas fa-arrow-right"></i> رجوع
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
