@model Medical.PL.Data.Models.Prescription

@{
    ViewData["Title"] = "حذف الوصفة الطبية";
    ViewData["ActivePage"] = "Doctors";
    var fromProfile = ViewData["From"]?.ToString() == "profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/appointment-delete.css" asp-append-version="true" />
}

<div class="del-wrap">
    <div class="del-card">
        <div class="del-icon">
            <i class="fas fa-file-medical"></i>
        </div>
        <h2>تأكيد حذف الوصفة الطبية</h2>
        <p>هل أنت متأكد من حذف هذه الوصفة؟ لا يمكن التراجع عن هذا الإجراء.</p>

        <div class="del-info">
            <div class="del-info-row">
                <span class="del-info-label">رقم الوصفة</span>
                <span class="del-info-val">Ps-@(Model.Id.ToString("D4"))</span>
            </div>
            <div class="del-info-row">
                <span class="del-info-label">المريض</span>
                <span class="del-info-val">@(Model.Patient?.User?.Name ?? "—")</span>
            </div>
            @if (Model.Appointment != null)
            {
                <div class="del-info-row">
                    <span class="del-info-label">تاريخ الكشف</span>
                    <span class="del-info-val del-ltr">@Model.Appointment.AppointmentDate.ToString("yyyy/MM/dd")</span>
                </div>
                <div class="del-info-row">
                    <span class="del-info-label">وقت الكشف</span>
                    <span class="del-info-val del-ltr">@Model.Appointment.AppointmentTime.ToString(@"hh\:mm")</span>
                </div>
            }
            <div class="del-info-row">
                <span class="del-info-label">عدد الأدوية</span>
                <span class="del-info-val">@Model.Items.Count دواء</span>
            </div>
        </div>

        <form asp-action="DeletePrescription" asp-route-id="@Model.Id" asp-route-from="@ViewData["From"]" method="post">
            @Html.AntiForgeryToken()
            <div class="del-actions">
                <button type="submit" class="btn-del-yes">
                    <i class="fas fa-trash"></i> نعم، احذف
                </button>
                @if (fromProfile)
                {
                    <a asp-controller="Doctor" asp-action="MyProfile" class="btn-del-no">
                        <i class="fas fa-times"></i> إلغاء
                    </a>
                }
                else
                {
                    <a asp-action="Prescriptions" asp-route-id="@Model.DoctorId" class="btn-del-no">
                        <i class="fas fa-times"></i> إلغاء
                    </a>
                }
            </div>
        </form>
    </div>
</div>
