@model ICollection<Medical.PL.Data.Models.Prescription>

@{
    ViewData["Title"] = "وصفات الطبيب";
    ViewData["ActivePage"] = "Doctors";
    string doctorName     = ViewBag.DoctorName     ?? "الطبيب";
    int    doctorId       = ViewBag.DoctorId       ?? 0;
    bool   doctorIsActive = ViewBag.DoctorIsActive ?? false;
    int    psIndex        = 1;
}

@section Styles {
    <link rel="stylesheet" href="~/css/patient-prescriptions.css" asp-append-version="true" />
    <style>
        .rx-action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            border-radius: 8px;
            font-size: 0.75rem;
            text-decoration: none;
            transition: background 0.2s, color 0.2s;
            border: none;
            cursor: pointer;
        }
        .rx-btn-edit  { background: #EFF6FF; color: #2563EB; }
        .rx-btn-edit:hover  { background: #DBEAFE; color: #1D4ED8; }
        .rx-btn-delete { background: #FEF2F2; color: #B91C1C; }
        .rx-btn-delete:hover { background: #FEE2E2; color: #991B1B; }
    </style>
}

<div class="rx-header" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
    <h1><i class="fas fa-file-prescription"></i> وصفات الطبيب</h1>
    @if (doctorId > 0 && doctorIsActive)
    {
        <a asp-action="WritePrescription" asp-route-id="@doctorId"
           style="display:inline-flex; align-items:center; gap:8px; padding:12px 22px; border-radius:14px; background:linear-gradient(135deg,#0891b2,#06b6d4); color:#fff; text-decoration:none; font-weight:700; font-size:0.9rem;">
            <i class="fas fa-plus"></i> وصفة جديدة
        </a>
    }
</div>

<div class="rx-breadcrumb">
    <a asp-action="Index">الأطباء</a>
    <i class="fas fa-chevron-left"></i>
    @if (doctorId > 0)
    {
        <a asp-action="Details" asp-route-id="@doctorId">د. @doctorName</a>
    }
    else
    {
        <span>د. @doctorName</span>
    }
    <i class="fas fa-chevron-left"></i>
    <span>الوصفات الطبية</span>
</div>

<div class="rx-subheader">
    <span class="rx-patient-name"><i class="fas fa-user-doctor" style="color:#0891B2; margin-left:6px;"></i>د. @doctorName</span>
    <span class="rx-count-badge">@Model.Count وصفة</span>
</div>

@if (!Model.Any())
{
    <div class="rx-empty">
        <i class="fas fa-file-medical-alt"></i>
        <h3>لا توجد وصفات طبية</h3>
        <p>لم يقم الطبيب بإصدار أي وصفات طبية بعد.</p>
    </div>
}
else
{
    @foreach (var ps in Model)
    {
        var bodyId = $"body-{ps.Id}";
        var chevId = $"chev-{ps.Id}";

        <div class="rx-card">

            <div class="rx-card-header" onclick="toggleRx('@bodyId', '@chevId')">
                <div class="rx-card-header-right">
                    <span class="rx-num">وصفة #@psIndex</span>
                    <span class="rx-id-pill">Ps-@(ps.Id.ToString("D4"))</span>
                    <span class="rx-items-pill">@ps.Items.Count دواء</span>
                    @if (ps.Appointment != null)
                    {
                        <span class="rx-id-pill" style="background:#F0FDFA; color:#0D9488;">@ps.Appointment.AppointmentDate.ToString("dd/MM/yyyy")</span>
                    }
                </div>
                <div class="rx-card-header-left">
                    @if (ps.Patient?.User != null)
                    {
                        <span class="rx-doctor-meta"><i class="fas fa-user" style="margin-left:4px;"></i>@ps.Patient.User.Name</span>
                    }
                    <a asp-action="EditPrescription" asp-route-id="@ps.Id"
                       class="rx-action-btn rx-btn-edit" onclick="event.stopPropagation()" title="تعديل الوصفة">
                        <i class="fas fa-pen"></i>
                    </a>
                    <a asp-action="DeletePrescription" asp-route-id="@ps.Id"
                       class="rx-action-btn rx-btn-delete" onclick="event.stopPropagation()" title="حذف الوصفة">
                        <i class="fas fa-trash"></i>
                    </a>
                    <i class="fas fa-chevron-down rx-chevron" id="@chevId"></i>
                </div>
            </div>

            <div class="rx-card-body" id="@bodyId">

                @if (ps.Patient?.User != null)
                {
                    <div class="rx-doctor-strip">
                        <div class="rx-doctor-avatar">@ps.Patient.User.Name[0].ToString().ToUpper()</div>
                        <div>
                            <div class="rx-doctor-name">@ps.Patient.User.Name</div>
                            <div class="rx-doctor-label">المريض</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ps.Patient.User.PhoneNumber))
                        {
                            <div style="margin-right:auto; font-size:0.82rem; color:#64748B;">
                                <i class="fas fa-phone" style="margin-left:4px;"></i>@ps.Patient.User.PhoneNumber
                            </div>
                        }
                    </div>
                }

                @if (ps.Appointment != null)
                {
                    <div class="rx-date-strip">
                        <i class="fas fa-calendar-alt"></i>
                        <span>تاريخ الزيارة: <strong>@ps.Appointment.AppointmentDate.ToString("dd/MM/yyyy")</strong></span>
                        <span style="margin-right:20px; color:#94A3B8;">|</span>
                        <i class="fas fa-clock"></i>
                        <span>@ps.Appointment.AppointmentTime.ToString(@"hh\:mm")</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ps.Notes))
                {
                    <div class="rx-notes-row">
                        <span class="rx-notes-label"><i class="fas fa-sticky-note"></i> ملاحظات:</span>
                        <span>@ps.Notes</span>
                    </div>
                }

                <div class="rx-medicines">
                    <div class="rx-medicines-title">
                        <i class="fas fa-pills"></i>
                        الأدوية الموصوفة
                    </div>

                    @if (!ps.Items.Any())
                    {
                        <p class="rx-no-items">لا توجد أدوية مسجلة في هذه الوصفة.</p>
                    }
                    else
                    {
                        <table class="rx-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>الدواء</th>
                                    <th>الجرعة</th>
                                    <th>الكمية</th>
                                    <th>المدة</th>
                                    <th>التعليمات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var itemNo = 1; }
                                @foreach (var item in ps.Items)
                                {
                                    <tr>
                                        <td style="color:#94A3B8; font-size:0.8rem; font-weight:700;">@itemNo</td>
                                        <td>
                                            <div class="rx-med-name">@item.Medicine?.Name</div>
                                            @if (!string.IsNullOrWhiteSpace(item.Medicine?.GenericName))
                                            {
                                                <div class="rx-med-generic">@item.Medicine.GenericName</div>
                                            }
                                        </td>
                                        <td><span class="rx-dosage-pill">@item.Dosage</span></td>
                                        <td style="font-weight:700;">@item.Quantity</td>
                                        <td style="color:#334155;">@item.Duration</td>
                                        <td style="color:#64748B;">@(item.Instructions ?? "—")</td>
                                    </tr>
                                    itemNo++;
                                }
                            </tbody>
                        </table>
                    }
                </div>

            </div>
        </div>

        psIndex++;
    }
}

<div class="rx-footer">
    @if (doctorId > 0)
    {
        <a asp-action="Details" asp-route-id="@doctorId" class="btn-rx-back">
            <i class="fas fa-arrow-right"></i> العودة لبيانات الطبيب
        </a>
    }
    else
    {
        <a asp-action="Index" class="btn-rx-back">
            <i class="fas fa-arrow-right"></i> العودة للأطباء
        </a>
    }
</div>

@section Scripts {
    <script>
        function toggleRx(bodyId, chevId) {
            const body = document.getElementById(bodyId);
            const chev = document.getElementById(chevId);
            const isOpen = body.classList.contains('open');
            body.classList.toggle('open', !isOpen);
            chev.classList.toggle('open', !isOpen);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const firstBody = document.querySelector('.rx-card-body');
            const firstChev = document.querySelector('.rx-chevron');
            if (firstBody) firstBody.classList.add('open');
            if (firstChev) firstChev.classList.add('open');
        });
    </script>
}
