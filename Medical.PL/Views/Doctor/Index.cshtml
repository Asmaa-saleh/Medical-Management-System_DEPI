@model IEnumerable<Medical.PL.Data.Models.Doctor>
@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-semibold mb-0">Doctors</h2>
        <small class="text-muted">Manage hospital medical staff</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Doctor
    </a>
</div>

@* Stat Cards *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 h-100" style="background:#f8f9fa">
            <div class="card-body">
                <div class="text-muted small mb-1">Total Doctors</div>
                <div class="fs-3 fw-semibold">@Model.Count()</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 h-100" style="background:#eaf3de">
            <div class="card-body">
                <div class="text-muted small mb-1">Active</div>
                <div class="fs-3 fw-semibold text-success">
                    @Model.Count(d => d.IsActive)
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 h-100" style="background:#f1efe8">
            <div class="card-body">
                <div class="text-muted small mb-1">Inactive</div>
                <div class="fs-3 fw-semibold text-secondary">
                    @Model.Count(d => !d.IsActive)
                </div>
            </div>
        </div>
    </div>
</div>

@* Table *@
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Doctor</th>
                    <th>Department</th>
                    <th>Specialization</th>
                    <th>Experience</th>
                    <th>Status</th>
                    <th class="pe-3 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td class="ps-3">
                            <div class="d-flex align-items-center gap-2">
                                @if (d.Image != null)
                                {
                                    <img src="@d.Image" class="rounded-circle"
                                         width="38" height="38" style="object-fit:cover" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-primary bg-opacity-10
                                                        text-primary d-flex align-items-center
                                                        justify-content-center fw-semibold"
                                         style="width:38px;height:38px;font-size:13px">
                                        @(d.User?.UserName?.Substring(0, 2).ToUpper() ?? "DR")
                                    </div>
                                }
                                <div>
                                    <div class="fw-medium" style="font-size:14px">
                                        @d.User?.UserName
                                    </div>
                                    <div class="text-muted" style="font-size:12px">
                                        @d.User?.Email
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>@d.Department?.Name</td>
                        <td>@d.Specialization</td>
                        <td>@d.ExperienceYears yrs</td>
                        <td>
                            @if (d.IsActive)
                            {
                                <span class="badge rounded-pill"
                                      style="background:#eaf3de;color:#3b6d11">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill"
                                      style="background:#f1efe8;color:#5f5e5a">
                                    Inactive
                                </span>
                            }
                        </td>
                        <td class="pe-3 text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-action="Details" asp-route-id="@d.Id"
                                   class="btn btn-sm btn-outline-secondary"
                                   title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@d.Id"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@d.Id"
                                   class="btn btn-sm btn-outline-danger"
                                   title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-person-x fs-2 d-block mb-2"></i>
                            No doctors found. <a asp-action="Create">Add one?</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
