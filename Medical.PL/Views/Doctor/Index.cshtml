@model IEnumerable<Medical.PL.Data.Models.Doctor>

@{
    ViewData["Title"] = "الأطباء";
    ViewData["ActivePage"] = "Doctors";
}

@section Styles {
    <link rel="stylesheet" href="~/css/doctor-index.css" asp-append-version="true" />
}

<div class="pg-header">
    <div>
        <h1><i class="fas fa-user-doctor"></i> الأطباء</h1>
        <p>إدارة بيانات الأطباء والحسابات المرتبطة بهم داخل النظام.</p>
    </div>

    <a asp-action="Create" class="btn-add">
        <i class="fas fa-plus"></i>
        إضافة طبيب جديد
    </a>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon si-blue"><i class="fas fa-user-doctor"></i></div>
        <div>
            <div class="stat-label">إجمالي الأطباء</div>
            <div class="stat-value">@Model.Count()</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon si-green"><i class="fas fa-user-check"></i></div>
        <div>
            <div class="stat-label">الأطباء النشطون</div>
            <div class="stat-value">@Model.Count(d => d.IsActive)</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon si-gray"><i class="fas fa-user-slash"></i></div>
        <div>
            <div class="stat-label">الأطباء غير النشطين</div>
            <div class="stat-value">@Model.Count(d => !d.IsActive)</div>
        </div>
    </div>
</div>

<div class="tbl-card">
    @if (Model.Any())
    {
        <table class="tbl">
            <thead>
                <tr>
                    <th>الطبيب</th>
                    <th>القسم</th>
                    <th>التخصص</th>
                    <th>سنوات الخبرة</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doctor in Model)
                {
                    <tr>
                        <td>
                            <div class="doctor-cell">
                                @if (!string.IsNullOrWhiteSpace(doctor.Image))
                                {
                                    <img src="@doctor.Image" alt="صورة الطبيب" class="doctor-avatar-img" />
                                }
                                else
                                {
                                    <div class="doctor-avatar">
                                        @(doctor.User?.Name?.Length > 0 ? doctor.User.Name[0].ToString().ToUpper() : "د")
                                    </div>
                                }

                                <div>
                                    <div class="doctor-name">د. @doctor.User?.Name</div>
                                    <div class="doctor-meta">@doctor.User?.Email</div>
                                </div>
                            </div>
                        </td>
                        <td>@doctor.Department?.Name</td>
                        <td>@doctor.Specialization</td>
                        <td>@doctor.ExperienceYears سنة</td>
                        <td>
                            <span class="status-badge @(doctor.IsActive ? "sb-active" : "sb-inactive")">
                                <i class="fas @(doctor.IsActive ? "fa-circle-check" : "fa-circle-minus")"></i>
                                @(doctor.IsActive ? "نشط" : "غير نشط")
                            </span>
                        </td>
                        <td>
                            <div class="act-btns">
                                <a asp-action="Details" asp-route-id="@doctor.Id" class="act-btn ab-view" title="عرض">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Prescriptions" asp-route-id="@doctor.Id" class="act-btn ab-view" title="الوصفات الطبية" style="background:#F5F3FF; color:#7C3AED;">
                                    <i class="fas fa-file-prescription"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@doctor.Id" class="act-btn ab-edit" title="تعديل">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@doctor.Id" class="act-btn ab-delete" title="حذف">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty">
            <i class="fas fa-user-doctor"></i>
            <h3>لا يوجد أطباء حاليًا</h3>
            <p>ابدأ بإضافة طبيب جديد مع إنشاء حسابه مباشرة من نفس الشاشة.</p>
            <a asp-action="Create" class="btn-add">
                <i class="fas fa-plus"></i>
                إضافة طبيب
            </a>
        </div>
    }
</div>
