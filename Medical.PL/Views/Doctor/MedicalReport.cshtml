@model Medical.PL.ViewModels.MedicalReportViewModel

@{
    ViewData["Title"] = "التقرير الطبي";
}

@section Styles {
    <link rel="stylesheet" href="~/css/doctor-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/doctor-profile.css" asp-append-version="true" />
    <style>
        /* ── Info grid (appointment header) ── */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 32px;
        }

        @@media (max-width: 900px) { .info-grid { grid-template-columns: repeat(2, 1fr); } }
        @@media (max-width: 540px)  { .info-grid { grid-template-columns: 1fr; } }

        .info-item {
            background: #f8fafc;
            border: 1px solid #eef2f7;
            border-radius: 14px;
            padding: 14px 16px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .info-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: #64748b;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .info-label i { color: #0891b2; font-size: 0.75rem; }

        .info-value {
            font-size: 0.95rem;
            font-weight: 800;
            color: #0f172a;
        }

        /* ── Rx table ── */
        .rx-wrap { overflow-x: auto; }

        .rx-tbl {
            width: 100%;
            border-collapse: collapse;
        }

        .rx-tbl thead th {
            padding: 12px 14px;
            text-align: right;
            font-size: 0.78rem;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            background: #f8fafc;
            border: 1px solid #eef2f7;
            white-space: nowrap;
        }

        .rx-tbl tbody td {
            padding: 10px 12px;
            border: 1px solid #eef2f7;
            vertical-align: top;
        }

        .rx-tbl tbody tr:hover td { background: #fafbfc; }

        .rx-tbl .fc {
            padding: 10px 14px;
            font-size: 0.88rem;
            border-radius: 10px;
        }

        .rx-tbl select.fc {
            background-position: left 12px center;
            padding-left: 34px;
        }

        /* ── Remove row button ── */
        .btn-rm {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border: none;
            border-radius: 10px;
            background: #fef2f2;
            color: #b91c1c;
            font-size: 0.82rem;
            cursor: pointer;
            transition: background 0.2s;
            flex-shrink: 0;
        }

        .btn-rm:hover { background: #fee2e2; }

        /* ── Add row button ── */
        .btn-add-row {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            background: transparent;
            color: #64748b;
            font-family: 'Cairo', sans-serif;
            font-size: 0.88rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-add-row:hover {
            border-color: #0891b2;
            color: #0891b2;
            background: #f0f9ff;
        }

        /* ── Print overrides ── */
        .print-only { display: none; }

        @@media print {
            .mc-navbar, .mc-footer, .form-actions,
            .btn-save, .btn-back, .btn-add-row, .btn-rm,
            .text-danger, textarea, select, input[type="text"],
            input[type="number"], .no-print { display: none !important; }

            .print-only { display: block; }

            .form-card, .info-item {
                box-shadow: none !important;
                border-color: #cbd5e1 !important;
            }
        }
    </style>
}

@{
    var fromProfile = ViewData["From"]?.ToString() == "profile";
}

<!-- ── Page header ── -->
<div class="form-header" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;">
    <div>
        <h1><i class="fas fa-file-medical"></i> التقرير الطبي والروشتة</h1>
        <p>تسجيل التشخيص وإصدار الوصفة الطبية للمريض.</p>
    </div>
    <div style="display:flex; gap:10px; flex-wrap:wrap;" class="no-print">
        @if (fromProfile)
        {
            <a asp-controller="Doctor" asp-action="MyProfile" class="btn-back">
                <i class="fas fa-arrow-right"></i> رجوع للملف
            </a>
        }
        else
        {
            <a asp-controller="Appointment" asp-action="Details" asp-route-id="@Model.AppointmentId" class="btn-back">
                <i class="fas fa-arrow-right"></i> رجوع للحجز
            </a>
        }
        <button type="button" class="btn-save" style="background:linear-gradient(135deg,#475569,#64748b);" onclick="window.print()">
            <i class="fas fa-print"></i> طباعة
        </button>
    </div>
</div>

@if (!fromProfile && TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin: 0 48px 16px;" role="alert">
        <i class="fas fa-circle-check"></i> @TempData["SuccessMessage"]
    </div>
}

<!-- ── Appointment info card ── -->
<div class="form-card" style="margin-bottom:20px;">
    <div class="section-title"><i class="fas fa-info-circle"></i> بيانات الحجز</div>
    <div class="info-grid">
        <div class="info-item">
            <span class="info-label"><i class="fas fa-user"></i> المريض</span>
            <span class="info-value">@Model.PatientName</span>
        </div>
        <div class="info-item">
            <span class="info-label"><i class="fas fa-phone"></i> رقم الهاتف</span>
            <span class="info-value">@(string.IsNullOrWhiteSpace(Model.PatientPhone) ? "غير مسجل" : Model.PatientPhone)</span>
        </div>
        <div class="info-item">
            <span class="info-label"><i class="fas fa-user-doctor"></i> الطبيب</span>
            <span class="info-value">د. @Model.DoctorName</span>
        </div>
        <div class="info-item">
            <span class="info-label"><i class="fas fa-stethoscope"></i> التخصص</span>
            <span class="info-value">@Model.DoctorSpecialization</span>
        </div>
        <div class="info-item">
            <span class="info-label"><i class="fas fa-concierge-bell"></i> الخدمة</span>
            <span class="info-value">@Model.ServiceName</span>
        </div>
        <div class="info-item">
            <span class="info-label"><i class="fas fa-calendar-day"></i> تاريخ الكشف</span>
            <span class="info-value">@Model.AppointmentDate.ToString("yyyy/MM/dd")</span>
        </div>
        <div class="info-item">
            <span class="info-label"><i class="fas fa-clock"></i> وقت الكشف</span>
            <span class="info-value">@Model.AppointmentTime.ToString(@"hh\:mm")</span>
        </div>
        <div class="info-item">
            <span class="info-label"><i class="fas fa-hashtag"></i> رقم الحجز</span>
            <span class="info-value">#@Model.AppointmentId</span>
        </div>
    </div>
</div>

<!-- ── Prescription form card ── -->
<div class="form-card">
    <form asp-action="MedicalReport" asp-route-id="@Model.AppointmentId" asp-route-from="@ViewData["From"]" method="post" id="rxForm">
        @Html.AntiForgeryToken()
        <input asp-for="AppointmentId" type="hidden" />
        <input asp-for="DoctorId" type="hidden" />
        <input asp-for="PatientId" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="validation-msg"></div>
        <span asp-validation-for="Items" class="text-danger d-block mb-3" style="font-size:0.85rem;"></span>

        <!-- Notes -->
        <div class="section-title"><i class="fas fa-notes-medical"></i> التشخيص والملاحظات</div>
        <div class="fg fg-full" style="margin-bottom:32px;">
            <div class="fg-item fg-full">
                <label asp-for="Notes"><i class="fas fa-align-right"></i> ملاحظات التقرير الطبي</label>
                <textarea asp-for="Notes" class="fc ta" rows="4" placeholder="اكتب التشخيص أو ملاحظات التقرير الطبي هنا..."></textarea>
                <div class="print-only" style="border:1px solid #e2e8f0; border-radius:10px; padding:14px; margin-top:8px; color:#334155; line-height:1.9;">
                    @(string.IsNullOrWhiteSpace(Model.Notes) ? "لا توجد ملاحظات" : Model.Notes)
                </div>
            </div>
        </div>

        <!-- Prescription table -->
        <div class="section-title"><i class="fas fa-prescription-bottle-medical"></i> الروشتة الطبية</div>

        <div class="rx-wrap">
            <table class="rx-tbl" id="rxTable">
                <thead>
                    <tr>
                        <th style="width:36px;">#</th>
                        <th style="min-width:200px;">الدواء</th>
                        <th style="min-width:160px;">الجرعة</th>
                        <th style="min-width:90px;">الكمية</th>
                        <th style="min-width:130px;">المدة</th>
                        <th style="min-width:160px;">التعليمات</th>
                        <th style="width:46px;" class="no-print"></th>
                    </tr>
                </thead>
                <tbody id="rxBody">
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        <tr class="rx-row">
                            <td style="color:#94a3b8; font-weight:800; font-size:0.82rem; text-align:center;">@(i + 1)</td>
                            <td>
                                <select asp-for="Items[@i].MedicineId" asp-items="ViewBag.Medicines" class="fc">
                                    <option value="">اختر الدواء</option>
                                </select>
                                <span asp-validation-for="Items[@i].MedicineId" class="text-danger" style="font-size:0.78rem;"></span>
                            </td>
                            <td>
                                <input asp-for="Items[@i].Dosage" class="fc" placeholder="مثال: قرص بعد الأكل" />
                                <span asp-validation-for="Items[@i].Dosage" class="text-danger" style="font-size:0.78rem;"></span>
                            </td>
                            <td>
                                <input asp-for="Items[@i].Quantity" class="fc" min="1" type="number" />
                                <span asp-validation-for="Items[@i].Quantity" class="text-danger" style="font-size:0.78rem;"></span>
                            </td>
                            <td>
                                <input asp-for="Items[@i].Duration" class="fc" placeholder="مثال: 5 أيام" />
                                <span asp-validation-for="Items[@i].Duration" class="text-danger" style="font-size:0.78rem;"></span>
                            </td>
                            <td>
                                <input asp-for="Items[@i].Instructions" class="fc" placeholder="تعليمات إضافية (اختياري)" />
                            </td>
                            <td class="no-print" style="text-align:center;">
                                <button type="button" class="btn-rm" onclick="removeRow(this)" title="حذف">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Add row button -->
        <div style="margin-top:14px;" class="no-print">
            <button type="button" class="btn-add-row" onclick="addRow()">
                <i class="fas fa-plus"></i> إضافة دواء آخر
            </button>
        </div>

        <!-- Form actions -->
        <div class="form-actions">
            <button type="submit" class="btn-save">
                <i class="fas fa-save"></i> حفظ التقرير
            </button>
            @if (fromProfile)
            {
                <a asp-controller="Doctor" asp-action="MyProfile" class="btn-back">
                    <i class="fas fa-arrow-right"></i> رجوع
                </a>
            }
            else
            {
                <a asp-controller="Appointment" asp-action="Details" asp-route-id="@Model.AppointmentId" class="btn-back">
                    <i class="fas fa-arrow-right"></i> رجوع
                </a>
            }
        </div>
    </form>
</div>

<!-- Hidden row template (rendered once, used by JS) -->
<template id="rowTemplate">
    <tr class="rx-row">
        <td style="color:#94a3b8; font-weight:800; font-size:0.82rem; text-align:center;" class="row-num"></td>
        <td>
            <select name="Items[__i__].MedicineId" class="fc">
                <option value="">اختر الدواء</option>
                @foreach (var med in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Medicines)
                {
                    <option value="@med.Value">@med.Text</option>
                }
            </select>
        </td>
        <td><input name="Items[__i__].Dosage" class="fc" placeholder="مثال: قرص بعد الأكل" /></td>
        <td><input name="Items[__i__].Quantity" class="fc" min="1" type="number" /></td>
        <td><input name="Items[__i__].Duration" class="fc" placeholder="مثال: 5 أيام" /></td>
        <td><input name="Items[__i__].Instructions" class="fc" placeholder="تعليمات إضافية (اختياري)" /></td>
        <td class="no-print" style="text-align:center;">
            <button type="button" class="btn-rm" onclick="removeRow(this)" title="حذف">
                <i class="fas fa-trash"></i>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function reindex() {
            document.querySelectorAll('#rxBody .rx-row').forEach(function (tr, idx) {
                // update row number display
                const numCell = tr.querySelector('.row-num');
                if (numCell) numCell.textContent = idx + 1;
                else tr.cells[0].textContent = idx + 1;

                // update name/id attributes
                tr.querySelectorAll('[name]').forEach(function (el) {
                    el.name = el.name.replace(/Items\[\d+\]/, 'Items[' + idx + ']');
                });
                tr.querySelectorAll('[id]').forEach(function (el) {
                    el.id = el.id.replace(/Items_\d+__/, 'Items_' + idx + '__');
                });
            });
        }

        function addRow() {
            const tmpl = document.getElementById('rowTemplate');
            const idx  = document.querySelectorAll('#rxBody .rx-row').length;
            const html = tmpl.innerHTML.replace(/__i__/g, idx);
            const tbody = document.getElementById('rxBody');
            tbody.insertAdjacentHTML('beforeend', html);
            // set number on newly added row
            const newRow = tbody.lastElementChild;
            newRow.querySelector('.row-num').textContent = idx + 1;
        }

        function removeRow(btn) {
            const rows = document.querySelectorAll('#rxBody .rx-row');
            if (rows.length <= 1) return; // keep at least 1
            btn.closest('tr').remove();
            reindex();
        }
    </script>
}
