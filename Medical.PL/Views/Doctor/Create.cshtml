@model Medical.PL.ViewModels.DoctorViewModel

@{
    ViewData["Title"] = "إضافة طبيب";
    ViewData["ActivePage"] = "Doctors";
}

@section Styles {
    <link rel="stylesheet" href="~/css/doctor-form.css" asp-append-version="true" />
}

<div class="form-header">
    <h1><i class="fas fa-user-doctor"></i> إضافة طبيب جديد</h1>
    <p>أدخل بيانات الطبيب والحساب الخاص به لإضافته للنظام من البداية.</p>
</div>

<div class="form-card">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("_Form", Model)

        <div class="form-actions">
            <button type="submit" class="btn-save">
                <i class="fas fa-check"></i>
                حفظ الطبيب
            </button>
            <a asp-action="Index" class="btn-back">
                <i class="fas fa-arrow-right"></i>
                رجوع
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
