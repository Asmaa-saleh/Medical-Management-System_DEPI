@model Medical.PL.ViewModels.DoctorViewModel

@{
    ViewData["Title"] = "تعديل بيانات طبيب";
    ViewData["ActivePage"] = "Doctors";
}

@section Styles {
    <link rel="stylesheet" href="~/css/doctor-form.css" asp-append-version="true" />
}

<div class="form-header">
    <h1><i class="fas fa-user-pen"></i> تعديل بيانات الطبيب</h1>
    <p>حدّث بيانات الطبيب الشخصية والطبية كما تحتاج.</p>
</div>

<div class="form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="UserId" type="hidden" />
        <input asp-for="Image" type="hidden" />

        @await Html.PartialAsync("_Form", Model)

        <div class="form-actions">
            <button type="submit" class="btn-save">
                <i class="fas fa-save"></i>
                حفظ التعديلات
            </button>
            <a asp-action="Index" class="btn-back">
                <i class="fas fa-arrow-right"></i>
                رجوع
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
