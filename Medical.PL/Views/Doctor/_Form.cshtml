@model Medical.PL.ViewModels.DoctorViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="UserId" class="form-label fw-medium small text-uppercase
               text-muted" style="letter-spacing:.05em"></label>
        <select asp-for="UserId" class="form-select"
                asp-items="@(ViewBag.Users as SelectList)">
            <option value="">— Select User —</option>
        </select>
        <span asp-validation-for="UserId" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="DepartmentId" class="form-label fw-medium small text-uppercase
               text-muted" style="letter-spacing:.05em"></label>
        <select asp-for="DepartmentId" class="form-select"
                asp-items="@(ViewBag.Departments as SelectList)">
            <option value="">— Select Department —</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Specialization" class="form-label fw-medium small text-uppercase
               text-muted" style="letter-spacing:.05em"></label>
        <input asp-for="Specialization" class="form-control"
               placeholder="e.g. Heart Surgery" />
        <span asp-validation-for="Specialization" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ExperienceYears" class="form-label fw-medium small text-uppercase
               text-muted" style="letter-spacing:.05em"></label>
        <input asp-for="ExperienceYears" class="form-control"
               type="number" min="0" max="60" />
        <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Bio" class="form-label fw-medium small text-uppercase
               text-muted" style="letter-spacing:.05em"></label>
        <textarea asp-for="Bio" class="form-control" rows="3"
                  placeholder="Write a short bio about the doctor..."></textarea>
        <span asp-validation-for="Bio" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="ImageFile" class="form-label fw-medium small text-uppercase
               text-muted" style="letter-spacing:.05em"></label>

        @if (Model?.Image != null)
        {
            <div class="mb-2 d-flex align-items-center gap-2">
                <img src="@Model.Image" id="previewImg" class="rounded-circle"
                     width="52" height="52" style="object-fit:cover" />
                <small class="text-muted">Current image — upload to replace</small>
            </div>
        }
        else
        {
            <div class="mb-2">
                <img id="previewImg" src="#" class="rounded-circle"
                     width="52" height="52"
                     style="object-fit:cover;display:none" />
            </div>
        }

        <input asp-for="ImageFile" type="file" class="form-control"
               accept="image/*" onchange="previewDoctorImage(event)" />
    </div>

    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" type="checkbox"
                   role="switch" />
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>
    </div>
</div>

<script>
    function previewDoctorImage(e) {
        const file = e.target.files[0];
        if (!file) return;
        const img = document.getElementById('previewImg');
        img.style.display = 'block';
        img.src = URL.createObjectURL(file);
    }
</script>