@model Medical.PL.Data.Models.Doctor

@{
    ViewData["Title"] = "حذف طبيب";
    ViewData["ActivePage"] = "Doctors";
}

@section Styles {
    <link rel="stylesheet" href="~/css/doctor-profile.css" asp-append-version="true" />
}

<div class="profile-header">
    <div>
        <h1><i class="fas fa-trash"></i> حذف الطبيب</h1>
        <p>راجع البيانات التالية قبل تنفيذ الحذف.</p>
    </div>

    <a asp-action="Index" class="btn-light-soft">
        <i class="fas fa-arrow-right"></i>
        رجوع
    </a>
</div>

<div class="profile-card">
    <div class="warn-box">
        <i class="fas fa-triangle-exclamation"></i>
        <div>
            <strong>تأكيد الحذف</strong>
            <p>سيتم حذف سجل الطبيب من النظام. تأكد أنك لا تحتاج هذه البيانات قبل المتابعة.</p>
        </div>
    </div>

    <div class="profile-top">
        @if (!string.IsNullOrWhiteSpace(Model.Image))
        {
            <img src="@Model.Image" alt="صورة الطبيب" class="profile-avatar-img" />
        }
        else
        {
            <div class="profile-avatar danger-avatar">
                @(Model.User?.Name?.Length > 0 ? Model.User.Name[0].ToString().ToUpper() : "د")
            </div>
        }

        <div class="profile-meta">
            <h2>د. @Model.User?.Name</h2>
            <p>@Model.Specialization - @Model.Department?.Name</p>
            <span class="status-badge @(Model.IsActive ? "sb-active" : "sb-inactive")">
                <i class="fas @(Model.IsActive ? "fa-circle-check" : "fa-circle-minus")"></i>
                @(Model.IsActive ? "نشط" : "غير نشط")
            </span>
        </div>
    </div>

    <div class="profile-grid">
        <div class="profile-item">
            <span class="profile-label"><i class="fas fa-envelope"></i> البريد الإلكتروني</span>
            <span class="profile-value">@Model.User?.Email</span>
        </div>

        <div class="profile-item">
            <span class="profile-label"><i class="fas fa-phone"></i> رقم الهاتف</span>
            <span class="profile-value">@Model.User?.PhoneNumber</span>
        </div>

        <div class="profile-item">
            <span class="profile-label"><i class="fas fa-hospital"></i> القسم</span>
            <span class="profile-value">@Model.Department?.Name</span>
        </div>

        <div class="profile-item">
            <span class="profile-label"><i class="fas fa-briefcase-medical"></i> الخبرة</span>
            <span class="profile-value">@Model.ExperienceYears سنة</span>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="profile-actions">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-danger-soft">
            <i class="fas fa-trash"></i>
            تأكيد الحذف
        </button>
        <a asp-action="Index" class="btn-light-soft">
            <i class="fas fa-xmark"></i>
            إلغاء
        </a>
    </form>
</div>
