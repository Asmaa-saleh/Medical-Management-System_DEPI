@model Medical.PL.Models.Doctor
@{
    ViewData["Title"] = "Delete Doctor";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-semibold mb-0">Delete Doctor</h2>
        <small class="text-muted">Please confirm this action</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-4">

        {{/* Warning */}}
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4 rounded-3">
            <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
            <span>
                Are you sure you want to delete this doctor?
                This action <strong>cannot be undone</strong>.
            </span>
        </div>

        {{/* Doctor Info */}}
        <div class="d-flex align-items-center gap-3 pb-3 mb-4 border-bottom">
            @if (Model.Image != null)
            {
                <img src="@Model.Image" class="rounded-circle"
                     width="64" height="64" style="object-fit:cover" />
            }
            else
            {
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger
                                d-flex align-items-center justify-content-center fw-bold"
                     style="width:64px;height:64px;font-size:22px">
                    @(Model.User?.UserName?.Substring(0, 2).ToUpper() ?? "DR")
                </div>
            }
            <div>
                <h5 class="mb-1">@Model.User?.UserName</h5>
                <div class="text-muted small">
                    @Model.Department?.Name &nbsp;·&nbsp; @Model.Specialization
                </div>
                @if (Model.IsActive)
                {
                    <span class="badge rounded-pill mt-1"
                          style="background:#eaf3de;color:#3b6d11">Active</span>
                }
                else
                {
                    <span class="badge rounded-pill mt-1"
                          style="background:#f1efe8;color:#5f5e5a">Inactive</span>
                }
            </div>
        </div>

        {{/* Summary */}}
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="text-uppercase text-muted fw-semibold mb-1"
                     style="font-size:11px;letter-spacing:.05em">
                    Department
                </div>
                <div>@Model.Department?.Name</div>
            </div>
            <div class="col-md-6">
                <div class="text-uppercase text-muted fw-semibold mb-1"
                     style="font-size:11px;letter-spacing:.05em">
                    Specialization
                </div>
                <div>@Model.Specialization</div>
            </div>
            <div class="col-md-6">
                <div class="text-uppercase text-muted fw-semibold mb-1"
                     style="font-size:11px;letter-spacing:.05em">
                    Experience
                </div>
                <div>@Model.ExperienceYears years</div>
            </div>
            <div class="col-md-6">
                <div class="text-uppercase text-muted fw-semibold mb-1"
                     style="font-size:11px;letter-spacing:.05em">
                    Email
                </div>
                <div>@Model.User?.Email</div>
            </div>
        </div>

        {{/* Buttons */}}
        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg me-1"></i> Cancel
            </a>
            <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i> Yes, Delete
                </button>
            </form>
        </div>

    </div>
</div>