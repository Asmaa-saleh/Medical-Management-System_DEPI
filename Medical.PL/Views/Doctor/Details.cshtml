@model Medical.PL.Data.Models.Doctor

@{
    ViewData["Title"] = "تفاصيل الطبيب";
    ViewData["ActivePage"] = "Doctors";
}

@section Styles {
    <link rel="stylesheet" href="~/css/doctor-profile.css" asp-append-version="true" />
}

<div class="profile-header">
    <div>
        <h1><i class="fas fa-user-doctor"></i> تفاصيل الطبيب</h1>
        <p>عرض كامل للبيانات الشخصية والطبية الخاصة بالطبيب.</p>
    </div>

    <div class="profile-actions-top">
        @if (Model.IsActive)
        {
            <a asp-action="WritePrescription" asp-route-id="@Model.Id" class="btn-primary-soft" style="background:#ecfdf5; color:#065f46;">
                <i class="fas fa-plus"></i>
                وصفة جديدة
            </a>
        }
        <a asp-action="Prescriptions" asp-route-id="@Model.Id" class="btn-primary-soft">
            <i class="fas fa-file-prescription"></i>
            الوصفات الطبية
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-primary-soft">
            <i class="fas fa-pen"></i>
            تعديل
        </a>
        <a asp-action="Index" class="btn-light-soft">
            <i class="fas fa-arrow-right"></i>
            رجوع
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin: 0 48px 16px; border-radius:14px;">
        <i class="fas fa-circle-exclamation"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="profile-card">
    <div class="profile-top">
        @if (!string.IsNullOrWhiteSpace(Model.Image))
        {
            <img src="@Model.Image" alt="صورة الطبيب" class="profile-avatar-img" />
        }
        else
        {
            <div class="profile-avatar">
                @(Model.User?.Name?.Length > 0 ? Model.User.Name[0].ToString().ToUpper() : "د")
            </div>
        }

        <div class="profile-meta">
            <h2>د. @Model.User?.Name</h2>
            <p>@Model.Specialization - @Model.Department?.Name</p>
            <span class="status-badge @(Model.IsActive ? "sb-active" : "sb-inactive")">
                <i class="fas @(Model.IsActive ? "fa-circle-check" : "fa-circle-minus")"></i>
                @(Model.IsActive ? "نشط" : "غير نشط")
            </span>
        </div>
    </div>

    <div class="profile-grid">
        <div class="profile-item">
            <span class="profile-label"><i class="fas fa-envelope"></i> البريد الإلكتروني</span>
            <span class="profile-value">@Model.User?.Email</span>
        </div>

        <div class="profile-item">
            <span class="profile-label"><i class="fas fa-phone"></i> رقم الهاتف</span>
            <span class="profile-value">@Model.User?.PhoneNumber</span>
        </div>

        <div class="profile-item">
            <span class="profile-label"><i class="fas fa-hospital"></i> القسم</span>
            <span class="profile-value">@Model.Department?.Name</span>
        </div>

        <div class="profile-item">
            <span class="profile-label"><i class="fas fa-stethoscope"></i> التخصص</span>
            <span class="profile-value">@Model.Specialization</span>
        </div>

        <div class="profile-item">
            <span class="profile-label"><i class="fas fa-briefcase-medical"></i> الخبرة</span>
            <span class="profile-value">@Model.ExperienceYears سنة</span>
        </div>

        <div class="profile-item">
            <span class="profile-label"><i class="fas fa-calendar-days"></i> تاريخ الميلاد</span>
            <span class="profile-value">@Model.User?.DateOfBirth.ToString("dd/MM/yyyy")</span>
        </div>

        <div class="profile-item">
            <span class="profile-label"><i class="fas fa-venus-mars"></i> النوع</span>
            <span class="profile-value">@Model.User?.Gender</span>
        </div>
    </div>

    <div class="profile-bio">
        <span class="profile-label"><i class="fas fa-align-right"></i> النبذة</span>
        <p>@(string.IsNullOrWhiteSpace(Model.Bio) ? "لا توجد نبذة مضافة لهذا الطبيب." : Model.Bio)</p>
    </div>

    <div class="profile-actions">
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-danger-soft">
            <i class="fas fa-trash"></i>
            حذف الطبيب
        </a>
    </div>
</div>
