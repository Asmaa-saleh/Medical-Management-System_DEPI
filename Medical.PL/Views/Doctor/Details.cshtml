@model Medical.PL.Models.Doctor
@{
    ViewData["Title"] = "Doctor Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-semibold mb-0">Doctor Details</h2>
        <small class="text-muted">Full profile information</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-4">

        {{/* Profile Header */}}
        <div class="d-flex align-items-center gap-3 pb-3 mb-4 border-bottom">
            @if (Model.Image != null)
            {
                <img src="@Model.Image" class="rounded-circle"
                     width="72" height="72" style="object-fit:cover" />
            }
            else
            {
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary
                                d-flex align-items-center justify-content-center fw-bold"
                     style="width:72px;height:72px;font-size:24px">
                    @(Model.User?.UserName?.Substring(0, 2).ToUpper() ?? "DR")
                </div>
            }
            <div>
                <h5 class="mb-1">@Model.User?.UserName</h5>
                <div class="text-muted small mb-1">
                    @Model.Department?.Name &nbsp;·&nbsp; @Model.Specialization
                </div>
                @if (Model.IsActive)
                {
                    <span class="badge rounded-pill"
                          style="background:#eaf3de;color:#3b6d11">Active</span>
                }
                else
                {
                    <span class="badge rounded-pill"
                          style="background:#f1efe8;color:#5f5e5a">Inactive</span>
                }
            </div>
        </div>

        {{/* Info Grid */}}
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="text-uppercase text-muted fw-semibold mb-1"
                     style="font-size:11px;letter-spacing:.05em">
                    Department
                </div>
                <div>@Model.Department?.Name</div>
            </div>
            <div class="col-md-6">
                <div class="text-uppercase text-muted fw-semibold mb-1"
                     style="font-size:11px;letter-spacing:.05em">
                    Specialization
                </div>
                <div>@Model.Specialization</div>
            </div>
            <div class="col-md-6">
                <div class="text-uppercase text-muted fw-semibold mb-1"
                     style="font-size:11px;letter-spacing:.05em">
                    Experience
                </div>
                <div>@Model.ExperienceYears years</div>
            </div>
            <div class="col-md-6">
                <div class="text-uppercase text-muted fw-semibold mb-1"
                     style="font-size:11px;letter-spacing:.05em">
                    Email
                </div>
                <div>@Model.User?.Email</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <div class="col-12">
                    <div class="text-uppercase text-muted fw-semibold mb-1"
                         style="font-size:11px;letter-spacing:.05em">
                        Bio
                    </div>
                    <p class="text-muted mb-0" style="line-height:1.7">@Model.Bio</p>
                </div>
            }
        </div>

        {{/* Actions */}}
        <div class="d-flex justify-content-end pt-3 border-top">
            <a asp-action="Delete" asp-route-id="@Model.Id"
               class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i> Delete
            </a>
        </div>
    </div>
</div>