@model SignInViewModel

@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <main class="auth-page">
        <section class="auth-panel">
            <div class="auth-card">
                <a asp-controller="Home" asp-action="Index" class="auth-brand">
                    <i class="fas fa-heartbeat"></i>
                    <span>MediCare</span>
                </a>

                <h1 class="auth-title">تسجيل الدخول</h1>

                <form asp-action="SignIn" method="post" class="auth-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly"></div>

                    <div class="auth-field">
                        <label asp-for="Email">البريد الإلكتروني</label>
                        <div class="auth-input-wrap">
                            <i class="fas fa-envelope"></i>
                            <input asp-for="Email" class="auth-input" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="auth-validation"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Password">كلمة المرور</label>
                        <div class="auth-input-wrap">
                            <i class="fas fa-lock"></i>
                            <input asp-for="Password" class="auth-input" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="auth-validation"></span>
                    </div>

                    <div class="auth-row">
                        <label class="auth-check">
                            <input asp-for="RememberMe" />
                            <span>تذكرني</span>
                        </label>
                    </div>

                    <button type="submit" class="auth-btn">
                        <i class="fas fa-right-to-bracket"></i>
                        دخول
                    </button>
                </form>

                <div class="auth-switch">
                    ليس لديك حساب؟ <a asp-action="SignUp">إنشاء حساب</a>
                </div>
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    @await Component.InvokeAsync("NToastNotify")
</body>
</html>
