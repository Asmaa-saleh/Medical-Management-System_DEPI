@model UserViewModel

@{
    ViewData["Title"] = "تعديل ملفي الشخصي";
    Layout = "~/Views/Shared/_LandingPageLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user.css" asp-append-version="true" />
}

<div class="user-header">
    <div class="user-title">
        <span class="user-title-icon"><i class="fas fa-user-pen"></i></span>
        <div>
            <h1>تعديل ملفي الشخصي</h1>
            <p>تحديث البيانات الشخصية</p>
        </div>
    </div>
</div>

<div class="user-form-card">
    <form asp-action="EditProfile" method="post" class="user-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly"></div>

        <div class="user-grid">
            <div class="user-field">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="user-input" placeholder="الاسم الكامل" />
                <span asp-validation-for="Name" class="user-validation"></span>
            </div>

            <div class="user-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="user-input" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="user-validation"></span>
            </div>
        </div>

        <div class="user-grid">
            <div class="user-field">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="user-input" placeholder="01000000000" />
                <span asp-validation-for="PhoneNumber" class="user-validation"></span>
            </div>

            <div class="user-field">
                <label asp-for="DateOfBirth"></label>
                <input asp-for="DateOfBirth" class="user-input" />
                <span asp-validation-for="DateOfBirth" class="user-validation"></span>
            </div>
        </div>

        <div class="user-field">
            <label asp-for="Gender"></label>
            <select asp-for="Gender" class="user-input">
                <option value="">اختر النوع</option>
                <option value="ذكر">ذكر</option>
                <option value="أنثى">أنثى</option>
            </select>
            <span asp-validation-for="Gender" class="user-validation"></span>
        </div>

        <div class="user-form-actions">
            <button type="submit" class="user-btn user-btn-primary">
                <i class="fas fa-save"></i>
                حفظ
            </button>
            <a asp-action="Profile" class="user-btn user-btn-light">
                <i class="fas fa-arrow-right"></i>
                رجوع
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
