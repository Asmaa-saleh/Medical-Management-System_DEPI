@model RoleViewModel

<form asp-action="@ViewData["FormAction"]" method="post" class="role-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly"></div>

    <div class="role-field">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="role-input" placeholder="مثال: Admin" />
        <span asp-validation-for="Name" class="role-validation"></span>
    </div>

    <div class="role-form-actions">
        <button type="submit" class="role-btn role-btn-primary">
            <i class="fas fa-save"></i>
            حفظ
        </button>
        <a asp-action="Index" class="role-btn role-btn-light">
            <i class="fas fa-arrow-right"></i>
            رجوع
        </a>
    </div>
</form>
