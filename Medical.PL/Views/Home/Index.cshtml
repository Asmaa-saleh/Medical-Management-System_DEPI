        </div>
        <div class="hero-visual" data-aos="fade-right" data-aos-duration="1000" data-aos-delay="200">
            <div class="hero-ring"></div>
            <div class="hero-ring-2"></div>
            <div class="hero-center"><i class="fas fa-hospital"></i></div>
            <div class="oi oi-1"><i class="fas fa-calendar-check"></i></div>
            <div class="oi oi-2"><i class="fas fa-pills"></i></div>
            <div class="oi oi-3"><i class="fas fa-user-md"></i></div>
            <div class="oi oi-4"><i class="fas fa-heartbeat"></i></div>
            <div class="oi oi-5"><i class="fas fa-stethoscope"></i></div>
            <div class="oi oi-6"><i class="fas fa-syringe"></i></div>
