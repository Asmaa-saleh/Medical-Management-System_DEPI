@model DepartmentViewModel
@{
    ViewData["ActivePage"] = "Departments";
}
@section Styles {
    <link rel="stylesheet" href="~/css/appointment-form.css" asp-append-version="true" />
}
<div class="form-header">
    <h1><i class="fas fa-edit"></i> تعديل بيانات القسم</h1>
    <p>تعديل: @Model.Name</p>
</div>
<partial name="_DepartmentForm" model="Model" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}