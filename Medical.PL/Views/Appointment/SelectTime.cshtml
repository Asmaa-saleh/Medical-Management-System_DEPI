@model SelectTimeVM
@using System.Globalization

@{
    var doctor = ViewBag.Doctor as Doctor;

    Layout = "~/Views/Shared/_LandingPageLayout.cshtml";
}

@{
    var culture = new CultureInfo("ar-EG");
}


<style>
    .booking-layout {
        display: flex;
        gap: 24px;
        align-items: flex-start;
    }

    .booking-sidebar {
        width: 280px;
        flex-shrink: 0;
        position: sticky;
        top: 100px;
    }

    .booking-content {
        flex: 1;
    }

    /* DATES */
    .dates-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 16px;
        margin-bottom: 30px;
    }

    .date-card {
        background: #fff;
        border: 1px solid #edf2f7;
        border-radius: 20px;
        padding: 18px;
        text-align: center;
        text-decoration: none;
        transition: .3s;
        color: #0f172a;
        box-shadow: 0 8px 20px rgba(15,23,42,.05);
    }

        .date-card:hover {
            transform: translateY(-4px);
            border-color: #B36995;
        }

        .date-card.active {
            background: #B36995;
            color: #fff;
            border-color: #B36995;
        }

    .date-day {
        display: block;
        font-size: 14px;
        margin-bottom: 8px;
        color: #64748b;
    }

    .date-card.active .date-day {
        color: #f1f5f9;
    }

    .date-number {
        font-size: 18px;
        font-weight: 700;
    }

    /* CALENDAR */
    .calendar-box {
        background: #fff;
        border-radius: 24px;
        padding: 24px;
        margin-bottom: 25px;
        box-shadow: 0 10px 30px rgba(15,23,42,.06);
        border: 1px solid #edf2f7;
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        padding-bottom: 18px;
        border-bottom: 1px solid #f1f5f9;
    }

        .calendar-header h4 {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
        }

        .calendar-header span {
            color: #64748b;
            font-size: 14px;
        }

    /* TIMES */
    .calendar-times {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 14px;
    }

    .time-slot {
        text-align: center;
        padding: 12px 18px;
        border-radius: 14px;
        text-decoration: none;
        background: #ECFEFF;
        color: #0E7490;
        font-weight: 700;
        border: 1px solid #BAE6FD;
        transition: .25s;
    }

        .time-slot:hover {
            background: #0E7490;
            color: white;
            transform: translateY(-2px);
        }

        .time-slot.booked {
            background: #f1f5f9;
            color: #94a3b8;
            border: 1px solid #e2e8f0;
            cursor: not-allowed;
        }

    .empty-slots {
        padding: 20px;
        text-align: center;
        background: #fef2f2;
        color: #dc2626;
        border-radius: 16px;
        font-weight: 600;
    }

    /* RESPONSIVE */
    @@media(max-width: 1200px) {
        .calendar-times {
            grid-template-columns: repeat(5, 1fr);
        }
    }

    @@media(max-width: 768px) {
        .calendar-times {
            grid-template-columns: repeat(4, 1fr);
        }

        .dates-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .booking-layout {
            flex-direction: column;
        }

        .booking-sidebar {
            width: 100%;
            position: static;
        }
    }

    @@media (max-width: 500px) {
        .calendar-times {
            grid-template-columns: repeat(2, 1fr);
        }
    }

</style>

<div class="booking-layout">

    <!-- RIGHT SIDEBAR -->
    <div class="booking-sidebar">
        @await Html.PartialAsync("_BookingStepper", 3)
    </div>

    <!-- MAIN CONTENT -->
    <div class="booking-content">

        <h2 class="mb-2">اختيار الموعد</h2>

        <p class="text-muted">
            د. @doctor.User.Name
        </p>

        <!-- Calendar -->
        <div class="dates-grid">

            @{
                var availableDates = new List<DateTime>();

                for (int i = 0; i < 14; i++)
                {
                    var date = DateTime.Today.AddDays(i);

                    var arabicDay = date.DayOfWeek switch
                    {
                        DayOfWeek.Saturday => "السبت",
                        DayOfWeek.Sunday => "الأحد",
                        DayOfWeek.Monday => "الاثنين",
                        DayOfWeek.Tuesday => "الثلاثاء",
                        DayOfWeek.Wednesday => "الأربعاء",
                        DayOfWeek.Thursday => "الخميس",
                        DayOfWeek.Friday => "الجمعة",
                        _ => ""
                    };

                    if (Model.AvailableDays.Contains(arabicDay))
                    {
                        availableDates.Add(date);
                    }
                }
            }

            @foreach (var date in availableDates)
            {
                <a asp-action="SelectTime"
                       asp-route-doctorId="@Model.DoctorId"
                       asp-route-serviceId="@Model.ServiceId"
                       asp-route-selectedDate="@date.ToString("yyyy-MM-dd", culture)"
                       class="date-card @(Model.SelectedDate.Date == date.Date ? "active" : "")">

                    <span class="date-day">
                        @date.ToString("dddd", culture)
                    </span>

                    <strong class="date-number">
                        @date.ToString("dd MMM", culture)
                    </strong>

                </a>
            }

        </div>

        <!-- Calendar Schedule -->
        <div class="calendar-box">

            <div class="calendar-header">

                <div>
                    <h4>
                        @Model.SelectedDate.ToString("dddd", culture)
                    </h4>

                    <span>
                        @Model.SelectedDate.ToString("dd MMMM yyyy", culture)
                    </span>
                </div>

            </div>

            @if (Model.Slots.Any())
            {
                <div class="calendar-times">

                    @foreach (var slot in Model.Slots)
                    {
                        if (!slot.IsBooked)
                        {
                            <a asp-action="ConfirmBooking"
                                   asp-route-serviceId="@Model.ServiceId"
                                   asp-route-doctorId="@Model.DoctorId"
                                   asp-route-scheduleId="@slot.ScheduleId"
                                   asp-route-date="@Model.SelectedDate"
                                   asp-route-time="@slot.Time"
                                   class="time-slot">

                                @slot.Time.ToString(@"hh\:mm")

                            </a>
                        }
                        else
                        {
                            <button class="time-slot booked" disabled>
                                @slot.Time.ToString(@"hh\:mm")
                            </button>
                        }
                    }

                </div>
            }
            else
            {
                <div class="empty-slots">
                    لا توجد مواعيد متاحة لهذا اليوم
                </div>
            }

        </div>

    </div>
</div>