@model ConfirmBookingVM
@{
    Layout = "~/Views/Shared/_LandingPageLayout.cshtml";
}

<style>

    .confirm-container {
        max-width: 900px;
        margin: 40px auto;
    }

    .confirm-card {
        background: #fff;
        border-radius: 24px;
        padding: 30px;
        border: 1px solid #edf2f7;
        box-shadow: 0 10px 30px rgba(15,23,42,.06);
    }

    .confirm-title {
        margin-bottom: 25px;
    }

        .confirm-title h2 {
            font-size: 30px;
            font-weight: 700;
            color: #0f172a;
        }

    .confirm-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 20px;
        margin-top: 20px;
    }

    .info-box {
        background: #f8fafc;
        border-radius: 18px;
        padding: 18px;
    }

        .info-box span {
            display: block;
            font-size: 13px;
            color: #64748b;
            margin-bottom: 8px;
        }

        .info-box strong {
            color: #0f172a;
            font-size: 16px;
        }

    .confirm-actions {
        margin-top: 30px;
        display: flex;
        gap: 15px;
        justify-content: flex-end;
    }

    .btn-confirm {
        background: #B36995;
        color: white;
        border: none;
        padding: 12px 28px;
        border-radius: 14px;
        font-weight: 600;
        transition: .3s;
    }

        .btn-confirm:hover {
            background: #155e75;
        }

    .btn-back {
        background: #e2e8f0;
        color: #0f172a;
        text-decoration: none;
        padding: 12px 28px;
        border-radius: 14px;
        font-weight: 600;
    }

    @@media(max-width:768px) {

        .confirm-grid {
            grid-template-columns: 1fr;
        }
    }

</style>

<div class="confirm-container">

    <div class="confirm-card">

        <div class="confirm-title">
            <h2>تأكيد الحجز</h2>
        </div>

        <div class="confirm-grid">

            <div class="info-box">
                <span>الخدمة</span>
                <strong>@Model.ServiceName</strong>
            </div>

            <div class="info-box">
                <span>الدكتور</span>
                <strong>د. @Model.DoctorName</strong>
            </div>

            <div class="info-box">
                <span>اليوم</span>
                <strong>@Model.DayName</strong>
            </div>

            <div class="info-box">
                <span>تاريخ الحجز</span>
                <strong>@Model.Date.ToString("yyyy/MM/dd")</strong>
            </div>

            <div class="info-box">
                <span>الوقت</span>
                <strong>@Model.Time</strong>
            </div>

            <div class="info-box">
                <span>اسم المريض</span>
                <strong>@Model.Patient.Name</strong>
            </div>

            <div class="info-box">
                <span>البريد الإلكتروني</span>
                <strong>@Model.Patient.Email</strong>
            </div>

            <div class="info-box">
                <span>رقم الهاتف</span>
                <strong>@Model.Patient.Phone</strong>
            </div>

        </div>

        <form asp-action="ConfirmBooking" method="post">

            <input type="hidden" asp-for="ServiceId" />
            <input type="hidden" asp-for="DoctorId" />
            <input type="hidden" asp-for="ScheduleId" />
            <input type="hidden" asp-for="Date" />
            <input type="hidden" asp-for="Time" />

            <input type="hidden" asp-for="Patient.Name" />
            <input type="hidden" asp-for="Patient.Email" />
            <input type="hidden" asp-for="Patient.Phone" />
            <input type="hidden" asp-for="Patient.Gender" />
            <input type="hidden" asp-for="Patient.DateOfBirth" />

            <div class="confirm-actions">

                <a asp-action="Booking"
                       class="btn-back">
                    رجوع
                </a>

                <button type="submit"
                        class="btn-confirm">

                    تأكيد الحجز

                </button>

            </div>

        </form>

    </div>

</div>