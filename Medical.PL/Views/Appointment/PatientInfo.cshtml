@model Medical.PL.ViewModels.PatientVM

@{
    var summary = new
    {
        ServiceName = ViewBag.ServiceName,
        DoctorName = ViewBag.DoctorName,
        DayName = ViewBag.DayName,
        Date = ViewBag.Date,
        Time = ViewBag.Time
    };
}

<style>
    .booking-layout {
        display: grid;
        grid-template-columns: 280px 1fr 320px;
        gap: 20px;
    }

    .patient-form {
        background: #fff;
        padding: 25px;
        border-radius: 20px;
        border: 1px solid #edf2f7;
        box-shadow: 0 8px 25px rgba(15,23,42,0.05);
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 18px;
    }

    .form-group label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        color: #0f172a;
    }

    .form-control {
        width: 100%;
        padding: 10px 14px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .btn-next {
        margin-top: 20px;
        background: #B36995;
        color: white;
        padding: 12px 20px;
        border-radius: 12px;
        border: none;
        font-weight: 600;
    }

    @@media(max-width: 992px) {
        .booking-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="booking-layout">

    <!-- Stepper -->
    <div class="booking-sidebar">
        @await Html.PartialAsync("_BookingStepper", 4)
    </div>

    <!-- Form -->
    <div class="booking-content">

        <div class="page-title">
            <h2>بيانات المريض</h2>
            <p>من فضلك املأ البيانات لإكمال الحجز</p>
        </div>

        <form asp-action="PatientInfo" method="post" class="patient-form">

            <input type="hidden" name="serviceId" value="@ViewBag.ServiceId" />
            <input type="hidden" name="doctorId" value="@ViewBag.DoctorId" />
            <input type="hidden" name="scheduleId" value="@ViewBag.ScheduleId" />
            <input type="hidden" name="date" value="@ViewBag.Date" />
            <input type="hidden" name="time" value="@ViewBag.Time" />

            <div class="form-grid">

                <div class="form-group">
                    <label>الاسم</label>
                    <input asp-for="Name" class="form-control" />
                </div>

                <div class="form-group">
                    <label>البريد الإلكتروني</label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="form-group">
                    <label>رقم الهاتف</label>
                    <input asp-for="Phone" class="form-control" />
                </div>

                <div class="form-group">
                    <label>تاريخ الميلاد</label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                </div>

                <div class="form-group">
                    <label>النوع</label>
                    <select asp-for="Gender" class="form-control">
                        <option value="">اختر</option>
                        <option>ذكر</option>
                        <option>أنثى</option>
                    </select>
                </div>

            </div>

            <button type="submit" class="btn-next">
                تأكيد و المتابعة
            </button>

        </form>

    </div>

    

</div>